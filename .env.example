# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Frontend-safe anon key ONLY. Never the service_role key (CLAUDE.md § Security & Secrets #3).
SUPABASE_ANON_KEY=your-anon-key

# TMDB — https://www.themoviedb.org/settings/api (instant approval)
TMDB_API_KEY=your-tmdb-v3-api-key

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Model routed via OpenRouter. The cheap tier is deliberate for RECOMMENDATIONS —
# that task is "name some films" and Haiku does it well. See docs/DECISIONS.md.
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# The taste verdict alone runs on a stronger model (D-053): four prompt versions
# could not get the cheap tier to write in a plain spoken register, and the model
# turned out to be the constraint rather than the wording. ~0.29c a verdict.
# Optional — omit it and the verdict uses the same default anyway.
OPENROUTER_VERDICT_MODEL=anthropic/claude-sonnet-5

# Optional
PORT=3000
