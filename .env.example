# Copy to .env and fill in. .env is gitignored — never commit real values.

# Supabase — Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Frontend-safe anon key ONLY. Never the service_role key (CLAUDE.md § Security & Secrets #3).
SUPABASE_ANON_KEY=your-anon-key

# TMDB — https://www.themoviedb.org/settings/api (instant approval)
TMDB_API_KEY=your-tmdb-v3-api-key

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key

# Model routed via OpenRouter for both AI features. Cheap model is deliberate —
# the tasks are narrow (pick titles / one-liner). See docs/DECISIONS.md.
OPENROUTER_MODEL=anthropic/claude-3.5-haiku

# Optional
PORT=3000
